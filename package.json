{
  "name": "releases-cli",
  "version": "0.67.1",
  "private": true,
  "description": "CLI and shared packages for Releases — the changelog & release-notes registry for developers and AI agents.",
  "type": "module",
  "bin": {
    "releases": "./src/index.ts"
  },
  "scripts": {
    "prebuild": "rm -f .*.bun-build",
    "build": "bun build --compile src/index.ts --outfile dist/releases",
    "build:linux": "bun build --compile src/index.ts --outfile dist/releases --target=bun-linux-x64",
    "build:linux-arm64": "bun build --compile src/index.ts --outfile dist/releases --target=bun-linux-arm64",
    "build:darwin-x64": "bun build --compile src/index.ts --outfile dist/releases --target=bun-darwin-x64",
    "build:windows-x64": "bun build --compile src/index.ts --outfile dist/releases.exe --target=bun-windows-x64",
    "dev": "bun --watch src/index.ts",
    "sync:version": "bun scripts/sync-version.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version && bun scripts/sync-version.ts && bun install",
    "changeset:publish": "changeset publish",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "oxlint",
    "check": "bun run lint && bun run format:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint",
      "oxfmt --write"
    ],
    "*.{json,jsonc,md,yml,yaml,css}": [
      "oxfmt --write"
    ]
  },
  "workspaces": [
    "npm/*",
    "packages/*"
  ],
  "keywords": [
    "cli",
    "changelog",
    "releases",
    "mcp",
    "ai-agents"
  ],
  "author": "Build Internet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildinternet/releases-cli.git"
  },
  "homepage": "https://releases.sh",
  "dependencies": {
    "@buildinternet/releases-api-types": "^0.35.0",
    "@buildinternet/releases-core": "^0.25.0",
    "@buildinternet/releases-lib": "workspace:*",
    "@buildinternet/releases-skills": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "string-width": "^7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "latest",
    "@types/node": "^22.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
