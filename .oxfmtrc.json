{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".claude",
    "node_modules",
    "dist",
    "**/*.d.ts",
    "bun.lock",
    "package-lock.json",
    "packages/*/dist",
    "npm/*/bin",
    "skills",
    "plugins/claude/releases/skills",
    ".*.bun-build"
  ]
}
