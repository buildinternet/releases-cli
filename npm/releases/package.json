{
  "name": "@buildinternet/releases",
  "version": "0.54.0",
  "description": "The changelog & release-notes registry for developers and AI agents",
  "bin": {
    "releases": "bin/releases"
  },
  "scripts": {
    "prepack": "cp ../../README.md ./README.md"
  },
  "files": [
    "bin/releases",
    "README.md"
  ],
  "optionalDependencies": {
    "@buildinternet/releases-darwin-arm64": "0.54.0",
    "@buildinternet/releases-darwin-x64": "0.54.0",
    "@buildinternet/releases-linux-x64": "0.54.0",
    "@buildinternet/releases-linux-arm64": "0.54.0",
    "@buildinternet/releases-windows-x64": "0.54.0"
  },
  "keywords": [
    "changelog",
    "releases",
    "mcp",
    "ai"
  ],
  "homepage": "https://releases.sh",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildinternet/releases-cli.git",
    "directory": "npm/releases"
  }
}
